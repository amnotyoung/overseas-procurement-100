# 빌드 산출물 — python3 tools/build_site.py 로 재생성된다
site/

# 원본 자료집 PDF (26MB, KOICA 발간물) — 로컬 보관하고 저장소에는 올리지 않는다.
# 추출된 텍스트는 sources/koica-2025-asia-pacific/pages/ 에 있어 작업에는 지장이 없다.
# sources/laws/ 아래 법령 원문 PDF는 대조 근거이므로 추적한다.
/*.pdf

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# 로컬 전용 설정
.claude/settings.local.json

# Node — 프로세스 보드 품질 게이트(korea100studio audit)의 의존성.
# package.json / package-lock.json 은 추적하되 설치물은 무시한다.
node_modules/

# 배포용 단일 파일 — build_site.py로 재생성된다
dist/
